# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=your_openai_or_compatible_api_key_here

# ── Optional (shown with defaults) ────────────────────────────────────────────
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru
MAX_FILE_MB=100
WHISPER_TIMEOUT=600

# ── Polling (default) ─────────────────────────────────────────────────────────
USE_WEBHOOK=false

# ── Webhook (set USE_WEBHOOK=true and fill these) ─────────────────────────────
# USE_WEBHOOK=true
# WEBHOOK_URL=https://your.public.domain.com
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080

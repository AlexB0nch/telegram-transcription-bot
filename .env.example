# ── Telegram (Required) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ── Access Control (Optional) ─────────────────────────────────────────────────
# Comma-separated list of admin Telegram IDs or @usernames.
# If left empty, the first user who messages the bot automatically becomes admin.
# ADMIN_IDS=@your_username

# ── AssemblyAI (Required) ─────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Optional (shown with defaults) ────────────────────────────────────────────
ASSEMBLYAI_LANGUAGE=ru
ASSEMBLYAI_TIMEOUT=900
DIARIZE=true
SPEAKERS_EXPECTED=0
MAX_FILE_MB=500
